<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs PilonHydraulika's WaterAnalyzer on the networks in
       crates/creabim-services/tests/parity and writes what it finds beside
       each, for the Rust tests to compare with. The core's project is taken
       from PilonCore (by default a pilondesigner checkout beside CreaBIM). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PilonCore Condition="'$(PilonCore)' == ''">$(MSBuildThisFileDirectory)../../../pilondesigner/core/PilonHydraulika.Core.csproj</PilonCore>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(PilonCore)" />
  </ItemGroup>
</Project>
